{
  "name": "jekyll-theme-merida",
  "version": "0.0.18",
  "description": "A minimal, responsive Jekyll theme for personal, academic, and technical writing websites.",
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i assets/css/merida.src.css -o assets/css/merida.css --minify",
    "css:watch": "npx @tailwindcss/cli -i assets/css/merida.src.css -o assets/css/merida.css --minify --watch",
    "jekyll:serve": "node tools/jekyll-serve-config-watch.cjs",
    "dev": "concurrently \"npm:css:watch\" \"npm:jekyll:serve\"",
    "release:gem": "bash ./tools/release-gem.sh"
  },
  "keywords": [
    "jekyll",
    "jekyll-theme",
    "static-site",
    "blog",
    "academic"
  ],
  "author": "Javad Mokhtari Koushyar",
  "license": "MIT",
  "homepage": "https://github.com/j0m0k0/jekyll-theme-merida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j0m0k0/jekyll-theme-merida.git"
  },
  "bugs": {
    "url": "https://github.com/j0m0k0/jekyll-theme-merida/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.2.1"
  }
}
